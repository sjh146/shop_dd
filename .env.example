# shop_dd environment example
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# URL of the blockchain-gateway "shop" instance.
SHOP_GATEWAY_URL=http://localhost:8091

# Internal API key used to authenticate against the gateway.
# The real key lives in ~/.hermes/secrets/shop_gateway_key.txt — copy it into
# your local `.env` (which is gitignored). Never commit a real key here.
SHOP_GATEWAY_INTERNAL_API_KEY=<your-internal-api-key>
